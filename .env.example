# TinyFish API Key (from https://agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (defaults to latest fast Flash model)
GEMINI_MODEL=gemini-3.5-flash

# Optional: NVIDIA Nemotron API Key (as automatic fallback if Gemini is unavailable or rate-limited)
# Get key from https://build.nvidia.com or OpenRouter
NEMOTRON_API_KEY=your_nemotron_api_key_here
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
